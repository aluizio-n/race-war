NODE_ENV=production
PORT=3333

# Postgres (used by docker-compose and DATABASE_URL)
POSTGRES_USER=racewar
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=racewar

# Database (for local dev, use localhost; in Docker, use postgres)
DATABASE_URL=postgresql://racewar:change-this-password@localhost:5432/racewar?schema=public

# JWT
JWT_SECRET=change-this-secret-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Web Push (VAPID) — gere as chaves com: npx web-push generate-vapid-keys
VAPID_EMAIL=admin@racewar.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
