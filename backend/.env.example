NODE_ENV=production
PORT=3333

# Postgres (used by docker-compose and DATABASE_URL)
POSTGRES_USER=racewar
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=racewar

# Database (for local dev, use localhost; in Docker, use postgres)
DATABASE_URL=postgresql://racewar:change-this-password@localhost:5432/racewar?schema=public

# JWT — JWT_SECRET must be at least 32 characters (generate: openssl rand -hex 32)
JWT_SECRET=change-this-secret-must-be-at-least-32-chars
# Access token lifetime (default: 15m). Shorter is safer.
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# CORS — comma-separated list of allowed origins (no trailing slash)
# Example: https://app.racewar.com,https://admin.racewar.com
CORS_ORIGIN=http://localhost:3000

# Bcrypt
BCRYPT_ROUNDS=12

# Web Push (VAPID) — gere as chaves com: npx web-push generate-vapid-keys
VAPID_EMAIL=admin@racewar.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
