generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityMode {
  RACE
  BIKE
  SKATE
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String   @unique
  name         String
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activities        Activity[]
  territories       Territory[]
  sentRequests      Friendship[]          @relation("SentRequests")
  receivedRequests  Friendship[]          @relation("ReceivedRequests")
  userChallenges    UserChallenge[]
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Activity {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  mode        ActivityMode
  distanceKm  Float        @default(0) @map("distance_km")
  durationSec Int          @default(0) @map("duration_sec")
  calories    Int          @default(0)
  paceMinKm   Float?       @map("pace_min_km")
  route       Json         // Array of { latitude, longitude }
  startedAt   DateTime     @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory Territory?

  @@map("activities")
}

model Territory {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  activityId  String       @unique @map("activity_id")
  mode        ActivityMode
  polygon     Json         // Array of { latitude, longitude }
  areaM2      Float        @map("area_m2")
  centerLat   Float        @map("center_lat")
  centerLng   Float        @map("center_lng")
  conqueredAt DateTime     @default(now()) @map("conquered_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("territories")
}

model Friendship {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friendships")
}

model Challenge {
  id          String          @id @default(uuid())
  title       String
  description String
  mode        ActivityMode?
  targetValue Float           @map("target_value")
  unit        String          // 'territories' | 'km' | 'm2' | 'days'
  rewardEmoji String          @map("reward_emoji")
  rewardName  String          @map("reward_name")
  rewardColor String          @map("reward_color")
  startsAt    DateTime        @map("starts_at")
  expiresAt   DateTime        @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  userChallenges UserChallenge[]

  @@map("challenges")
}

model UserChallenge {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  challengeId  String          @map("challenge_id")
  currentValue Float           @default(0) @map("current_value")
  status       ChallengeStatus @default(ACTIVE)
  completedAt  DateTime?       @map("completed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}
